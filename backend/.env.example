# ===========================================
# Nexus Web Conferencing App - Local Development
# ===========================================
# Copy this file to .env and customize values
# cp .env.example .env

# ===========================================
# General
# ===========================================
NODE_ENV=development

# ===========================================
# JWT Configuration
# ===========================================
# IMPORTANT: Change these in production!
JWT_ACCESS_SECRET=dev-access-secret-change-me-in-production-min-32-chars
JWT_REFRESH_SECRET=dev-refresh-secret-change-me-in-production-min-32-chars
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=7d

# ===========================================
# PostgreSQL Database
# ===========================================
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=nexus
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_POOL_MAX=20

# ===========================================
# Redis Cache
# ===========================================
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# ===========================================
# Kafka Message Broker
# ===========================================
# Use localhost:29092 for local dev (outside Docker)
# Use kafka:9092 for Docker Compose internal
KAFKA_BROKERS=localhost:29092
KAFKA_SSL=false
KAFKA_SASL_USERNAME=
KAFKA_SASL_PASSWORD=

# ===========================================
# Service Ports
# ===========================================
AUTH_SERVICE_PORT=3001
USER_SERVICE_PORT=3002
CHAT_SERVICE_PORT=3003
CALL_SIGNALING_SERVICE_PORT=3004
API_GATEWAY_PORT=8080

# ===========================================
# CORS Configuration
# ===========================================
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# ===========================================
# Email/SMTP Configuration
# ===========================================
# For local dev, you can use services like:
# - Mailhog (no auth needed, catches all emails)
# - Mailtrap (free tier available)
# - Gmail (requires app password)
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM=noreply@nexus.local

# ===========================================
# Frontend URLs
# ===========================================
FRONTEND_URL=http://localhost:3000
EMAIL_VERIFICATION_URL=http://localhost:3000/verify-email
PASSWORD_RESET_URL=http://localhost:3000/reset-password

# ===========================================
# Object Storage (S3/MinIO)
# ===========================================
# For local dev, you can run MinIO in Docker
STORAGE_BUCKET=nexus-profiles
STORAGE_REGION=us-east-1
STORAGE_ENDPOINT=http://localhost:9000
STORAGE_ACCESS_KEY=minioadmin
STORAGE_SECRET_KEY=minioadmin

# ===========================================
# Media Service (mediasoup/WebRTC)
# ===========================================
MEDIASOUP_LISTEN_IP=0.0.0.0
MEDIASOUP_ANNOUNCED_IP=127.0.0.1
RTC_MIN_PORT=40000
RTC_MAX_PORT=49999

# ===========================================
# TURN Server (WebRTC NAT Traversal)
# ===========================================
# Optional for local dev, required for production
TURN_URL=
TURN_USERNAME=
TURN_CREDENTIAL=

# ===========================================
# Logging
# ===========================================
LOG_LEVEL=debug
